{
  "name": "northeastour-monorepo",
  "version": "1.0.0",
  "private": true,
  "description": "Monorepo do projeto NortheasTour - Planejamento de Roteiros Turísticos Regionais",
  "workspaces": [
    "apps/*",
    "tests"
  ],
  "scripts": {
    "test": "npm run test --workspace=@northeastour/tests",
    "test:backend": "npm run test:backend --workspace=@northeastour/tests",
    "test:frontend": "npm run test:frontend --workspace=@northeastour/tests",
    "test:e2e": "npm run test:e2e --workspace=@northeastour/tests",
    "start:backend": "npm exec --workspace=apps/backend -- prisma generate && npm exec --workspace=apps/backend -- prisma db push && npm exec --workspace=apps/backend -- prisma db seed && npm run start:dev --workspace=apps/backend",
    "start:frontend": "npm run dev --workspace=apps/frontend",
    "build:backend": "npm run build --workspace=apps/backend",
    "build:frontend": "npm run build --workspace=apps/frontend",
    "build:all": "npm run build --workspaces --if-present",
    "docker:up": "docker compose up --build",
    "docker:down": "docker compose down -v"
  },
  "author": "Grupo 9",
  "license": "ISC",
  "dependencies": {
    "@nestjs/mapped-types": "^2.1.1",
    "@prisma/client": "^7.8.0",
    "prisma": "^7.8.0"
  }
}
