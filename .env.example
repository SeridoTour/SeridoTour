# Somente exemplos locais. Não inserir credenciais reais no Git.
POSTGRES_USER=seridotour
POSTGRES_PASSWORD=replace-local-database-password
POSTGRES_DB=seridotour_local
DB_PORT=5433
BACKEND_PORT=3000
FRONTEND_PORT=5173
DATABASE_URL="postgresql://seridotour:replace-local-database-password@localhost:5433/seridotour_local?schema=public"
VITE_API_URL=http://localhost:3000
CORS_ORIGIN=http://localhost:5173,http://127.0.0.1:5173
JWT_SECRET=replace-with-a-random-local-secret-of-at-least-32-characters
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
CLOUDINARY_CLOUD_NAME=configure-development-cloud
CLOUDINARY_API_KEY=configure-development-key
CLOUDINARY_API_SECRET=configure-development-secret
CLOUDINARY_FOLDER_PREFIX=seridotour/local
OPENWEATHER_API_KEY=
# Seed é opcional e aceita somente seridotour_demo ou seridotour_test_* em localhost.
LOCAL_DEMO_PASSWORD=replace-local-demo-password
